# ---------------------------------------------------------------------------
# AgriCast AI - Backend Environment Variables
# Copy this file to .env and fill in real values. NEVER commit .env.
# ---------------------------------------------------------------------------

# Server
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL=postgresql://agricast_user:agricast_password@localhost:5432/agricast_ai

# JWT
JWT_SECRET=replace_this_with_a_long_random_string_min_32_chars
JWT_EXPIRES_IN=7d

# Bcrypt
BCRYPT_SALT_ROUNDS=12

# Weather (Open-Meteo - no API key required)
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_TIMEOUT_MS=8000
OPEN_METEO_MAX_RETRIES=2
OPEN_METEO_RETRY_DELAY_MS=500
WEATHER_CACHE_TTL_CURRENT=900
WEATHER_CACHE_TTL_HOURLY=3600
WEATHER_CACHE_TTL_DAILY=10800

# Satellite (Sentinel Hub - https://www.sentinel-hub.com/)
# Create an OAuth client in the Sentinel Hub dashboard for these values.
# The satellite endpoints return 500 with a clear message if these are
# left blank - every other module works fine without them.
SENTINEL_CLIENT_ID=
SENTINEL_CLIENT_SECRET=
SENTINEL_OAUTH_URL=https://services.sentinel-hub.com/oauth/token
SENTINEL_PROCESS_URL=https://services.sentinel-hub.com/api/v1/process
SENTINEL_CATALOG_URL=https://services.sentinel-hub.com/api/v1/catalog/1.0.0/search
SENTINEL_TIMEOUT_MS=15000
SENTINEL_MAX_RETRIES=2
SENTINEL_RETRY_DELAY_MS=700
SATELLITE_BBOX_BUFFER_METERS=500
SATELLITE_IMAGE_WIDTH=512
SATELLITE_IMAGE_HEIGHT=512
SATELLITE_CACHE_TTL_SECONDS=21600
SATELLITE_DEFAULT_RANGE_DAYS=10

# AI Recommendations (Grok API - https://x.ai/api)
# The /api/v1/ai/recommend endpoint returns 500 with a clear message if
# GROK_API_KEY is left blank - every other module works fine without it.
GROK_API_URL=https://api.x.ai/v1/chat/completions
GROK_API_KEY=
GROK_MODEL=grok-4-fast
GROK_TIMEOUT_MS=20000
GROK_MAX_RETRIES=2
GROK_RETRY_DELAY_MS=800

# --- Auth upgrade: Google OAuth + refresh-token rotation -------------------
# Frontend origin allowed to receive the refreshToken cookie (falls back to
# CORS_ORIGIN above if unset).
FRONTEND_URL=http://localhost:5173

# Google OAuth (Google Cloud Console -> APIs & Services -> Credentials).
# Google sign-in returns 500 with a clear message if these are left blank -
# every other auth flow (email/password) still works without them.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Access token (short-lived, sent in the Authorization header)
JWT_ACCESS_EXPIRES_IN=15m

# Refresh token (long-lived, delivered via HttpOnly cookie, rotated on use)
JWT_REFRESH_SECRET=replace_this_with_a_different_long_random_string_min_32_chars
JWT_REFRESH_EXPIRES_IN=30d
JWT_REFRESH_EXPIRES_MS=2592000000

